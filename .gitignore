# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.DS_Store

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/
.idea/

# Compiled example binaries (build artifacts, not source)
examples/console_test/console_test
examples/gaps_coverage/gaps_coverage
examples/new_features/new_features
examples/quickstart/quickstart
examples/simple_example/simple_example
examples/simple_logger_test/simple_logger_test
examples/simple_test/simple_test
examples/feature_verify/feature_verify
examples/stress_test/stress_test
examples/level_filter_test/level_filter_test
examples/mount_main_test/mount_main_test
examples/robustness_verify/robustness_verify

# Example runtime log output
examples/**/logs/
examples/**/Log/

# Internal agent workspace (working memory, not project source)
.codebuddy/
